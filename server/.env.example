# ---------- Server ----------
PORT=4100
PUBLIC_URL=https://nivaas.yourdomain.com     # used in share links and Meta webhooks (HTTPS)
BASE_DOMAIN=nivaas.space                    # SaaS tenant subdomain base (for example: builder.nivaas.space)
# ---------- Session & Tokens (30 Days Login Window) ----------
JWT_SECRET=change-me-to-a-long-random-string # Replace with a random 32-byte secret in production
JWT_EXPIRES_IN=30d                           # Access token lifetime (30 days)
JWT_REFRESH_EXPIRES_IN=30d                   # Refresh token lifetime (30 days)
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=60

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://nivaas:nivaas@localhost:5432/nivaas
# Docker Compose only: set to `openssl rand -hex 24` output before deployment.
DB_PASSWORD=

# ---------- AI copilot + WhatsApp twin (Gemini API) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nivaas Real Estate OS <no-reply@nivaas.space>"

# ---------- WhatsApp Cloud API (Meta) ----------
META_APP_SECRET= # Required in production to verify WhatsApp webhook signatures
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=nivaas-verify-123 # Replace with a random token of at least 24 characters in production
WHATSAPP_WEBHOOK_ENABLED=false # Set true only after configuring both Meta secrets above
# Approved template sent from the agent's number when a lead is assigned (first message must be a template)
WA_INTRO_TEMPLATE=agent_intro_hi
WA_TEMPLATE_LANG=hi

# ---------- SaaS control plane (first-time initialization only) ----------
SUPERADMIN_INITIAL_NAME=
SUPERADMIN_INITIAL_EMAIL=
SUPERADMIN_INITIAL_PASSWORD= # Use a unique password with at least 16 characters; remove after db:init:master
